{
	"name": "pi-fireside-chat",
	"version": "1.0.0",
	"description": "Persistent side conversation pane for pi coding agents (oh-my-pi and earendil-works/pi)",
	"type": "module",
	"keywords": ["pi-package"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/5c0r/pi-fireside-chat.git"
	},
	"homepage": "https://github.com/5c0r/pi-fireside-chat#readme",
	"bugs": {
		"url": "https://github.com/5c0r/pi-fireside-chat/issues"
	},
	"files": ["index.ts", "api.ts", "context.ts", "host.d.ts", "README.md"],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "bun test && bun run typecheck",
		"prepublishOnly": "bun run check"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"typescript": "7.0.2"
	},
	"omp": {
		"extensions": ["./index.ts"]
	},
	"pi": {
		"extensions": ["./index.ts"]
	}
}
